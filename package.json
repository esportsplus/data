{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/utilities": "^0.28.0"
    },
    "description": "Compile-time data validation utility",
    "devDependencies": {
        "@esportsplus/typescript": "^0.29.5",
        "@types/node": "^26.1.1",
        "msgpackr": "^2.0.4",
        "protobufjs": "^8.7.1",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./compiler/tsc": {
            "types": "./build/compiler/plugins/tsc.d.ts",
            "default": "./build/compiler/plugins/tsc.js"
        },
        "./compiler/vite": {
            "types": "./build/compiler/plugins/vite.d.ts",
            "default": "./build/compiler/plugins/vite.js"
        }
    },
    "files": [
        "build"
    ],
    "main": "build/index.js",
    "name": "@esportsplus/data",
    "peerDependencies": {
        "esbuild": ">=0.17.0",
        "typescript": ">=5.0.0",
        "vite": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "esbuild": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/validation"
    },
    "scripts": {
        "build": "tsc",
        "build:test": "pnpm build && pnpm test",
        "-": "-",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build",
        "--": "--",
        "agent:test": "vitest run",
        "bench": "vitest bench",
        "test": "vitest run"
    },
    "sideEffects": false,
    "type": "module",
    "types": "build/index.d.ts",
    "version": "0.8.4"
}
